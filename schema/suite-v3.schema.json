{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-4-h.org/schemas/eval-suite-v3.json",
  "title": "AI4H Agent Tool-use Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "summary", "category", "risk", "license", "author", "tags", "runner", "cases"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 4, "maxLength": 100 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 300 },
    "category": { "type": "string", "minLength": 3, "maxLength": 80 },
    "risk": { "enum": ["low", "moderate", "high"] },
    "license": { "type": "string", "minLength": 3 },
    "author": { "type": "string", "minLength": 2 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "runner": {
      "type": "object", "additionalProperties": false, "required": ["id", "minimumVersion"],
      "properties": {
        "id": { "const": "@safeai4humanity/adversarial-mcp" },
        "minimumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "releasedAt": { "type": "string", "format": "date-time" },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 8 } },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/testCase" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "textContent": {
      "type": "object", "additionalProperties": false, "required": ["type", "text"],
      "properties": { "type": { "const": "text" }, "text": { "type": "string", "minLength": 1, "maxLength": 20000 } }
    },
    "toolResponse": {
      "type": "object", "additionalProperties": false, "required": ["content"],
      "properties": {
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textContent" } },
        "structuredContent": { "type": "object" },
        "isError": { "type": "boolean" }
      }
    },
    "assistantCriterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "anyOf"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 3 },
        "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "testCase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "task", "authorizedScope", "stopConditions", "prohibitedActions", "protectedCanaries", "sourceTool", "expectations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
        "task": { "type": "string", "minLength": 10, "maxLength": 4000 },
        "authorizedScope": {
          "type": "object", "additionalProperties": false, "required": ["targets", "actions", "boundary"],
          "properties": {
            "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "boundary": { "type": "string", "minLength": 10 }
          }
        },
        "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "protectedCanaries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourceTool": {
          "type": "object", "additionalProperties": false, "required": ["name", "title", "description", "inputMode", "clean", "poisoned"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "title": { "type": "string", "minLength": 3 },
            "description": { "type": "string", "minLength": 10 },
            "inputMode": { "enum": ["none", "query", "recordId"] },
            "clean": { "$ref": "#/$defs/toolResponse" },
            "poisoned": { "$ref": "#/$defs/toolResponse" }
          }
        },
        "expectations": {
          "type": "object", "additionalProperties": false,
          "required": ["requiredAssistant", "forbiddenAssistant", "forbiddenToolCalls", "forbiddenToolArgumentStrings", "humanReviewRubric"],
          "properties": {
            "requiredAssistant": {
              "type": "object", "additionalProperties": false, "required": ["clean", "poisoned"],
              "properties": {
                "clean": { "type": "array", "items": { "$ref": "#/$defs/assistantCriterion" } },
                "poisoned": { "type": "array", "items": { "$ref": "#/$defs/assistantCriterion" } }
              }
            },
            "forbiddenAssistant": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "forbiddenToolCalls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
            "forbiddenToolArgumentStrings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "humanReviewRubric": { "type": "string", "minLength": 20, "maxLength": 1500 }
          }
        }
      }
    }
  }
}
